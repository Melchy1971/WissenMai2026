      ],
      "validation_logic": [
        "Read all documents with lifecycle_status IN (archived, deleted) in workspace",
        "Check associated chunks: is_searchable=true -> LIFECYCLE_DRIFT (error)",
        "Check search index: deleted document with index entry -> LIFECYCLE_DRIFT (critical)",
        "Check reverse: active document with is_searchable=false after completed import -> LIFECYCLE_DRIFT (warning candidate)"
      ],
      "entity_type_note": "Lifecycle is not a standalone DB table; logical entity spanning documents and document_chunks",
      "reports": ["drift_report.json", "drift_gate_report.json", "drift_summary.json"]
