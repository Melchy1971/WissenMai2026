      "validation_logic": {
        "SEARCH_INDEX_DRIFT": [
          "Read all index_entry IDs in workspace from search index (read-only)",
          "Read all document_chunks.id with is_searchable=true in workspace",
          "Diff: index-only = Phantom; DB-only = Missing",
          "Any Phantom or Missing entry -> SEARCH_INDEX_DRIFT"
        ],
        "RETRIEVAL_DRIFT": [
          "Execute defined retrieval test queries against workspace (read-only)",
          "Calculate metric delta against golden baseline",
          "Delta > threshold -> RETRIEVAL_DRIFT"
        ]
      },
      "reports": ["drift_report.json", "drift_gate_report.json", "drift_history.json"]
    }
