{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wissen:report-schema:1",
  "title": "Wissen Report Schema",
  "description": "Versioned mandatory schema for active gate reports under reports/current. Enforced by scripts/validate_reports.py.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "report_schema_version",
    "report_name",
    "gate",
    "status",
    "timestamp",
    "environment",
    "collected",
    "passed",
    "failed",
    "errors",
    "skipped",
    "exit_code",
    "blockers",
    "source_command",
    "generated_by"
  ],
  "properties": {
    "report_schema_version": {
      "type": "integer",
      "const": 1
    },
    "report_name": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "INFO"]
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "report_type": {
      "type": "string",
      "enum": ["gate", "truth", "release_candidate", "informational"]
    },
    "collected": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "exit_code": {
      "type": "integer"
    },
    "blockers": {
      "type": "array"
    },
    "source_command": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "string",
      "const": "gate_validator"
    },
    "commit_hash": {
      "type": "string"
    }
  },
  "x-rules": [
    "Missing report_schema_version is invalid.",
    "Unknown report_schema_version is invalid.",
    "status PASS is allowed only when failed=0, errors=0, skipped=0.",
    "collected must be >0 unless report_type=informational.",
    "Numbers must be internally consistent: collected = passed + failed + errors + skipped."
    ,
    "Gate PASS/FAIL artifacts are valid only when generated_by=gate_validator.",
    "Final release reports are valid only when generated_by=gate_validator and based on validator output."
  ]
}
