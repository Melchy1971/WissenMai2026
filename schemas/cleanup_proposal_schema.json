{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CleanupProposal",
  "type": "object",
  "properties": {
    "proposal_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "workspace_id": { "type": "string" },
    "mode": { "type": "string", "enum": ["analyse", "vorschlag", "dry_run", "freigabe", "ausfuehrung"] },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_type": { "type": "string" },
          "object_id": { "type": "string" },
          "reason": { "type": "string" },
          "impact": { "type": "string" }
        },
        "required": ["object_type", "object_id", "reason"]
      }
    },
    "blocked_count": { "type": "integer", "minimum": 0 },
    "protected_count": { "type": "integer", "minimum": 0 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "reviewed_by": { "type": "string" },
    "approved": { "type": "boolean" },
    "audit_trail": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "proposal_id",
    "timestamp",
    "workspace_id",
    "mode",
    "candidates",
    "blocked_count",
    "protected_count",
    "candidate_count"
  ]
}
