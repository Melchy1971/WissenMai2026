APP_ENV=local
APP_VERSION=0.1.0
# APP_SPRINT=PRI-8
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+psycopg://wissensbasis:change-me@127.0.0.1:5432/wissensbasis
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

## ── Seed Credentials (Single Source of Truth, Stand 2026-05-26) ──
#
# Diese ENV-Variablen werden von allen Seed-/Bootstrap-Skripten gelesen:
#
#   SEED_ADMIN_LOGIN      (Default: admin@localhost)
#   SEED_ADMIN_PASSWORD   (Default: change-me)
#   SEED_WORKSPACE_NAME   (Default: Default Workspace)
#
# Legacy-Keys (werden noch als Fallback akzeptiert, aber nicht mehr gesetzt):
#   WISSEN_DEV_LOGIN
#   WISSEN_DEV_PASSWORD
#
# Niemals SEED_ADMIN_PASSWORD in Reports oder Logs ausgeben!
#
# > WARNUNG: Diese Datei ist nur für lokale Entwicklung. Niemals .env oder Klartext-Passwörter in produktive Doku oder ins Repository committen!
SEED_ADMIN_LOGIN=admin@localhost
SEED_ADMIN_PASSWORD=change-me
SEED_WORKSPACE_NAME=Default Workspace
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b
OCR_ENGINE=tesseract
BACKUP_TARGET_PATH=/mnt/external/wissensbasis-backups

## ── Backend API ──
MAX_UPLOAD_SIZE_BYTES=52428800
ADMIN_API_TOKEN=local-admin-token

## ── Verzeichnispfade ──
# IMPORT_JOBS_TEMP_DIR=/tmp/ruflo-imports
# ORIGINAL_FILE_STORE_DIR=/var/ruflo/files
# BACKUP_RESTORE_ROOT_DIR=/var/ruflo/restore

## ── Background Jobs ──
BACKGROUND_JOB_LOCK_TIMEOUT_SECONDS=300
BACKGROUND_JOB_HEARTBEAT_INTERVAL_SECONDS=30
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_RETRY_BACKOFF_SECONDS=30
